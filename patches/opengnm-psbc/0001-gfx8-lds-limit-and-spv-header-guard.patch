diff --git a/libpsbc/psbc_compile.c b/libpsbc/psbc_compile.c
--- a/libpsbc/psbc_compile.c
+++ b/libpsbc/psbc_compile.c
@@
 static void setup_ac_info(struct ac_compiler_info* ac_info, enum amd_gfx_level gfxlevel) {
     ac_info->gfx_level = gfxlevel;
+    /*
+     * Keep this limit in sync with ac_fill_compiler_info() in Mesa:
+     * GFX7+ workgroups may use up to 64 KiB of LDS; GFX6 is limited to 32 KiB.
+     * The standalone PSBC target setup previously left this field zero.
+     */
+    ac_info->lds_size_per_workgroup = gfxlevel >= GFX7 ? 64 * 1024 : 32 * 1024;
 
     if (gfxlevel >= GFX10_3) {
diff --git a/cmd/psbc/main.c b/cmd/psbc/main.c
--- a/cmd/psbc/main.c
+++ b/cmd/psbc/main.c
@@
-	FILE* inputhandle = fopen(opts.inputfile, "r");
+	FILE* inputhandle = fopen(opts.inputfile, "rb");
 	if (!inputhandle) {
 		fatalf("Failed to open input file with %s", strerror(errno));
 	}
 
-	fseek(inputhandle, 0, SEEK_END);
-	size_t inputlen = ftell(inputhandle);
-	fseek(inputhandle, 0, SEEK_SET);
+	if (fseek(inputhandle, 0, SEEK_END) != 0) {
+		fclose(inputhandle);
+		fatal("Failed to seek input SPIR-V file");
+	}
+	long inputlen_long = ftell(inputhandle);
+	if (inputlen_long < 20 || (inputlen_long % 4) != 0) {
+		fclose(inputhandle);
+		fatal("Invalid SPIR-V file size: truncated header or non-dword length");
+	}
+	size_t inputlen = (size_t)inputlen_long;
+	if (fseek(inputhandle, 0, SEEK_SET) != 0) {
+		fclose(inputhandle);
+		fatal("Failed to rewind input SPIR-V file");
+	}
@@
 	if (fread(input, 1, inputlen, inputhandle) != inputlen) {
+		fclose(inputhandle);
+		free(input);
 		fatalf("Failed to read input file with %s", strerror(errno));
 	}
 
 	fclose(inputhandle);
+
+	/* Reject malformed headers before handing untrusted words to NIR/ACO. */
+	const uint32_t* spirv_header = (const uint32_t*)input;
+	const uint32_t spirv_version = spirv_header[1];
+	const uint32_t spirv_major = (spirv_version >> 16) & 0xffu;
+	const uint32_t spirv_minor = (spirv_version >> 8) & 0xffu;
+	const uint32_t spirv_revision = spirv_version & 0xffu;
+	if (spirv_header[0] != 0x07230203u || spirv_major != 1u ||
+	    spirv_minor > 6u || spirv_revision != 0u ||
+	    (spirv_version >> 24) != 0u || spirv_header[3] == 0u ||
+	    spirv_header[4] != 0u) {
+		free(input);
+		fatal("Invalid SPIR-V header");
+	}
 
 	/* Compile via libpsbc */
