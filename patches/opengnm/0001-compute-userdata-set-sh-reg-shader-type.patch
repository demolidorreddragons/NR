+	setpersistentregisterrange_stage(
+	    cmd, stage, targetreg, (const uint32_t*)sampler, sampdwords
 	);
 }
 
@@ -1529,7 +1543,7 @@ void sceGnmDrawCmdSetPointerUserData(
 
 	const uint32_t ptrdwords = sizeof(ptr) / sizeof(uint32_t);
-	setpersistentregisterrange(
-	    cmd, targetreg, (const uint32_t*)&ptr, ptrdwords
+	setpersistentregisterrange_stage(
+	    cmd, stage, targetreg, (const uint32_t*)&ptr, ptrdwords
 	);
 }
