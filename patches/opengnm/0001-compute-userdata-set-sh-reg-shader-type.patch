+	setpersistentregisterrange_stage(
+	    cmd, stage, targetreg, (const uint32_t*)buf, texdwords
 	);
 }
 
@@ -1465,7 +1479,7 @@ void sceGnmDrawCmdSetTsharpUserData(
 
 	const uint32_t texdwords = sizeof(GnmTexture) / sizeof(uint32_t);
-	setpersistentregisterrange(
-	    cmd, targetreg, (const uint32_t*)tex, texdwords
+	setpersistentregisterrange_stage(
+	    cmd, stage, targetreg, (const uint32_t*)tex, texdwords
 	);
 }
 
@@ -1502,7 +1516,7 @@ void sceGnmDrawCmdSetSsharpUserData(
 
