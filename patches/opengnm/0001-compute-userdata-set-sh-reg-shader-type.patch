diff --git a/src/drawcommandbuffer.c b/src/drawcommandbuffer.c
index 0000000..0000000 100644
--- a/src/drawcommandbuffer.c
+++ b/src/drawcommandbuffer.c
@@ -66,9 +66,10 @@ static inline void setcontextregister(
 }
 
-static void setpersistentregisterrange(
+static void setpersistentregisterrange_internal(
     GnmCommandBuffer* cmd, uint32_t regaddr, const uint32_t* regvalues,
-    uint32_t numvalues
+    uint32_t numvalues, uint32_t shader_type
 ) {
 	if (regaddr < SI_SH_REG_OFFSET ||
 	    numvalues > (SI_SH_REG_END - regaddr) / sizeof(uint32_t)) {
@@ -88,7 +89,7 @@ static void setpersistentregisterrange(
 		return;
 	}
 
-	cmd->cmdptr[0] = PKT3(PKT3_SET_SH_REG, numvalues, 0);
+	cmd->cmdptr[0] = PKT3(PKT3_SET_SH_REG, numvalues, 0) | PKT3_SHADER_TYPE_S(shader_type);
 	cmd->cmdptr[1] = (regaddr - SI_SH_REG_OFFSET) >> 2;
 	for (uint32_t i = 0; i < numvalues; i += 1) {
 		cmd->cmdptr[2 + i] = regvalues[i];
@@ -96,6 +97,19 @@ static void setpersistentregisterrange(
 
 	cmd->cmdptr += numdwords;
 }
+
+static void setpersistentregisterrange(
+    GnmCommandBuffer* cmd, uint32_t regaddr, const uint32_t* regvalues,
+    uint32_t numvalues
+) {
+	setpersistentregisterrange_internal(cmd, regaddr, regvalues, numvalues, 0);
+}
+
+static void setpersistentregisterrange_stage(
+    GnmCommandBuffer* cmd, GnmShaderStage stage, uint32_t regaddr,
+    const uint32_t* regvalues, uint32_t numvalues
+) {
+	const uint32_t shader_type = stage == GNM_STAGE_CS ? 1u : 0u;
+	setpersistentregisterrange_internal(cmd, regaddr, regvalues, numvalues, shader_type);
+}
+
 static inline void setpersistentregister(
     GnmCommandBuffer* cmd, uint32_t regaddr, uint32_t regvalue
 ) {
