#version 450

// Minimal GFX8 compute bring-up kernel.
// Dispatch exactly one 64-thread workgroup; the buffers must contain 64 floats.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    float input_values[];
};

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
    float output_values[];
};

void main() {
    uint index = gl_GlobalInvocationID.x;
    output_values[index] = input_values[index] + 1.0;
}
