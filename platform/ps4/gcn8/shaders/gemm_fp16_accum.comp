#version 450
// FP16-rounded accumulation reference kernel.
// Values are stored in float SSBOs for broad compiler compatibility, but every
// operand and every accumulator update is rounded to IEEE binary16. This is a
// numerical emulation kernel, not a claim of native packed-FP16 GCN instructions.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer MatrixA { float a[]; };
layout(std430, binding = 1) readonly buffer MatrixB { float b[]; };
layout(std430, binding = 2) readonly buffer MatrixC { float c[]; };
layout(std430, binding = 3) writeonly buffer MatrixD { float d[]; };

layout(push_constant) uniform Params {
    uint rows;
    uint columns;
    uint inner;
    float alpha;
    float beta;
} params;

float round_to_half(float value) {
    return unpackHalf2x16(packHalf2x16(vec2(value, 0.0))).x;
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint column = gl_GlobalInvocationID.x;
    if (row >= params.rows || column >= params.columns) return;

    float accumulator = 0.0;
    for (uint k = 0u; k < params.inner; ++k) {
        float lhs = round_to_half(a[row * params.inner + k]);
        float rhs = round_to_half(b[k * params.columns + column]);
        accumulator = round_to_half(fma(lhs, rhs, accumulator));
    }

    uint output_index = row * params.columns + column;
    float scaled = round_to_half(params.alpha * accumulator);
    // Match GEMM beta=0 semantics without propagating NaNs from unused C.
    float residual = params.beta == 0.0
        ? 0.0
        : round_to_half(params.beta * round_to_half(c[output_index]));
    d[output_index] = round_to_half(scaled + residual);
}
