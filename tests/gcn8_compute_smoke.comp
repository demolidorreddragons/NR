#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer OutputBuffer {
    uint values[];
};

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < values.length()) {
        values[index] = index * 2u + 1u;
    }
}
